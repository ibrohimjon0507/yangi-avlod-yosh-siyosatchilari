# Admin paneliga kirish paroli (majburiy)
ADMIN_PASSWORD=
# Sessiya cookie'sini imzolash uchun uzun tasodifiy satr (tavsiya etiladi)
SESSION_SECRET=
# Vercel Blob ombori tokeni — Vercel'da omborni loyihaga ulaganda avtomatik qoʻshiladi.
# Lokal ishlab chiqishda: `vercel env pull .env.local`
BLOB_READ_WRITE_TOKEN=
# Saytning asosiy manzili (sitemap, Open Graph uchun). Vercel'da boʻlmasa, loyiha domeni olinadi.
NEXT_PUBLIC_SITE_URL=
